{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "target": "ES2020",
        "lib": ["ES2020", "DOM"]
    },
    "include": ["static/js/**/*"],
    "exclude": ["node_modules", "dist", "build"]
}
